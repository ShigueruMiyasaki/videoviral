# YouTube Data API v3
YOUTUBE_API_KEY=

# OpenAI — Whisper real (obrigatório para transcrição de áudio)
# https://platform.openai.com/api-keys
OPENAI_API_KEY=
WHISPER_MODEL=whisper-1
WHISPER_LANGUAGE=pt
WHISPER_TIMEOUT_SEC=120

# Google Gemini (recomendado para decisão de corte — custo baixo)
GEMINI_API_KEY=

# ElevenLabs (voz do avatar)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# HeyGen (avatar lip-sync) — listar avatars: GET /v2/avatars
HEYGEN_API_KEY=
HEYGEN_AVATAR_ID=
HEYGEN_AVATAR_STYLE=circle

# API local (dashboard). Na VPS o container escuta em 0.0.0.0 por conta própria.
API_HOST=127.0.0.1
API_PORT=8000

# Senha do painel. Vazio = sem senha, só na sua máquina.
# Na VPS o script deploy/vps-up.sh preenche isto se estiver vazio.
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=

# Domínio apontando para a VPS. Vazio publica em http://IP na porta 80.
VIDEOVIRAL_DOMAIN=

# Miner
MIN_ENGAGEMENT_SCORE=0.02

# DID_API_KEY=

# Distribuição
DISTRIBUTION_WEBHOOK_URL=

# Storage local (MVP)
STORAGE_ROOT=storage

# LLM preferido: gemini | openai
LLM_PROVIDER=gemini
